# Python executable used by the Next.js server
PYTHON_BIN=python3

# Optional absolute path to a yt-dlp checkout/install.
# If omitted, Python must be able to import yt_dlp.
YT_DLP_PYTHONPATH=

# Optional directory for temporary download jobs.
DOWNLOAD_TEMP_DIR=./server/jobs

# Maximum concurrent background jobs.
MAX_CONCURRENT_JOBS=2
